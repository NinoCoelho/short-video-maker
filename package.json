{
  "name": "short-video-maker",
  "version": "1.3.0",
  "description": "Creates short videos for TikTok, Instagram Reels, and YouTube Shorts using the Model Context Protocol (MCP) and a REST API.",
  "main": "index.js",
  "bugs": "https://github.com/gyoridavid/short-video-maker/issues",
  "homepage": "https://github.com/gyoridavid/short-video-maker",
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json && vite build && vite build --config vite.remotion.config.ts",
    "dev": "REMOTION_HOST=0.0.0.0 concurrently \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:ui": "vite",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:all": "tsx tests/e2e/run-e2e-tests.ts all",
    "test:e2e:basic": "tsx tests/e2e/run-e2e-tests.ts basic",
    "test:e2e:ui": "tsx tests/e2e/run-e2e-tests.ts ui",
    "test:e2e:websocket": "tsx tests/e2e/run-e2e-tests.ts websocket",
    "test:e2e:batch": "tsx tests/e2e/run-e2e-tests.ts batch",
    "test:e2e:edge-cases": "tsx tests/e2e/run-e2e-tests.ts edge-cases",
    "test:e2e:error-recovery": "tsx tests/e2e/run-e2e-tests.ts error-recovery",
    "test:e2e:debug": "tsx tests/e2e/run-e2e-tests.ts debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chrome": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:safari": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=\"Mobile Chrome\" --project=\"Mobile Safari\"",
    "test:e2e:report": "playwright show-report test-results/e2e-html-report",
    "test:e2e:install": "playwright install",
    "test:performance": "node --expose-gc ./node_modules/.bin/vitest run src/services/__tests__/*.performance.test.ts",
    "test:performance:watch": "node --expose-gc ./node_modules/.bin/vitest src/services/__tests__/*.performance.test.ts",
    "test:performance:report": "node --expose-gc src/services/__tests__/performance-runner.ts",
    "benchmark": "npm run test:performance -- --reporter=json > performance-report.json",
    "benchmark:memory": "node --expose-gc --inspect ./node_modules/.bin/vitest run src/services/__tests__/*.performance.test.ts",
    "prepublishOnly": "npm run build && echo \"#!/usr/bin/env node\n$(cat dist/index.js)\" > dist/index.js && chmod +x dist/index.js",
    "publish:docker": "npm run publish:docker:normal && npm run publish:docker:cuda && npm run publish:docker:tiny",
    "publish:docker:cuda": "docker buildx build --platform linux/amd64 -t gyoridavid/short-video-maker:latest-cuda -t gyoridavid/short-video-maker:${npm_package_version}-cuda -f main-cuda.Dockerfile --push ./",
    "publish:docker:normal": "docker buildx build --platform linux/amd64,linux/arm64 -t gyoridavid/short-video-maker:latest -t gyoridavid/short-video-maker:${npm_package_version} -f main.Dockerfile --push ./",
    "publish:docker:tiny": "docker buildx build --platform linux/amd64,linux/arm64 -t gyoridavid/short-video-maker:latest-tiny -t gyoridavid/short-video-maker:${npm_package_version}-tiny -f main-tiny.Dockerfile --push ./",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "ui:preview": "vite preview",
    "tts:service": "python scripts/tts/tts_service.py",
    "performance:start": "node performance/scripts/performanceMonitoring.js start",
    "performance:stop": "node performance/scripts/performanceMonitoring.js stop",
    "performance:status": "node performance/scripts/performanceMonitoring.js status",
    "performance:report": "node performance/scripts/performanceMonitoring.js report",
    "performance:baseline": "node performance/scripts/performanceMonitoring.js baseline",
    "performance:regression": "node performance/scripts/performanceMonitoring.js regression",
    "performance:optimize": "node performance/scripts/performanceMonitoring.js optimize",
    "performance:health": "node performance/scripts/performanceMonitoring.js health"
  },
  "bin": {
    "short-video-maker": "dist/index.js"
  },
  "files": [
    "dist",
    "static"
  ],
  "keywords": [
    "shorts",
    "mcp",
    "model context protocol",
    "reels",
    "tiktok",
    "youtube shorts",
    "youtube",
    "short video",
    "video creation",
    "instagram",
    "video",
    "generator",
    "remotion",
    "faceless video"
  ],
  "author": "David Gyori",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google-cloud/translate": "^9.2.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@mui/icons-material": "^5.15.10",
    "@mui/material": "^5.15.10",
    "@remotion/bundler": "^4.0.286",
    "@remotion/cli": "^4.0.286",
    "@remotion/google-fonts": "^4.0.306",
    "@remotion/install-whisper-cpp": "^4.0.286",
    "@remotion/renderer": "^4.0.286",
    "@remotion/zod-types": "^4.0.286",
    "@tanstack/react-query": "^5.18.0",
    "@types/lru-cache": "^7.10.9",
    "@types/multer": "^2.0.0",
    "@types/node-fetch": "^2.6.12",
    "@types/react-dropzone": "^4.2.2",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.9.0",
    "content-type": "^1.0.5",
    "cuid": "^3.0.0",
    "deepl-node": "^1.19.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.2",
    "fs-extra": "^11.3.0",
    "got": "^14.4.7",
    "http-proxy-middleware": "^3.0.5",
    "joi": "^17.13.3",
    "lru-cache": "^11.1.0",
    "multer": "^2.0.2",
    "nock": "^14.0.3",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "ollama": "^0.5.16",
    "openai": "^5.8.2",
    "pino": "^8.16.2",
    "playwright": "^1.54.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-router-dom": "^6.22.3",
    "remotion": "^4.0.286",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "whisper-node": "^1.1.1",
    "winston": "^3.17.0",
    "yt-dlp-exec": "^1.0.2",
    "zod": "3.22.3",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "^4.0.286",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/content-type": "^1.1.8",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/form-data": "^2.2.1",
    "@types/fs-extra": "^11.0.4",
    "@types/nock": "^11.1.0",
    "@types/node": "^22.15.21",
    "@types/puppeteer": "^5.4.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "jsdom": "^26.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "puppeteer": "^24.14.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.1"
  }
}
